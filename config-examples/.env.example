# Sample Environment Configuration for AI Testing Project

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ecommerce_db
MONGODB_TEST_URI=mongodb://localhost:27017/ecommerce_test_db

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Session Secret
SESSION_SECRET=your_session_secret_here

# Encryption Keys
ENCRYPTION_KEY=your_32_character_encryption_key

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Service (SendGrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=E-Commerce Platform

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-ecommerce-bucket

# Shipping Integration
SHIPSTATION_API_KEY=your_shipstation_key
SHIPSTATION_API_SECRET=your_shipstation_secret

# =============================================================================
# AI TESTING TOOLS CONFIGURATION
# =============================================================================

# Applitools (Visual AI Testing)
APPLITOOLS_API_KEY=your_applitools_api_key
APPLITOOLS_SERVER_URL=https://eyes.applitools.com
APPLITOOLS_BATCH_NAME=E-Commerce AI Visual Tests

# OpenAI (GPT-4 for Test Generation)
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Testim.io (AI Test Automation)
TESTIM_PROJECT_ID=your_testim_project_id
TESTIM_TOKEN=your_testim_token

# Snyk (AI Security Scanning)
SNYK_API_KEY=your_snyk_api_key
SNYK_ORG_ID=your_snyk_org_id

# Datadog (AI Monitoring)
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key
DATADOG_SITE=datadoghq.com

# New Relic (AI Ops)
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
NEW_RELIC_APP_NAME=E-Commerce Platform

# k6 Cloud (AI Performance Testing)
K6_CLOUD_TOKEN=your_k6_cloud_token
K6_CLOUD_PROJECT_ID=your_k6_project_id

# ReportPortal (AI Test Analytics)
REPORTPORTAL_ENDPOINT=http://localhost:8080
REPORTPORTAL_TOKEN=your_reportportal_token
REPORTPORTAL_PROJECT=ecommerce_testing

# Launchable (AI Test Selection)
LAUNCHABLE_TOKEN=your_launchable_token
LAUNCHABLE_ORGANIZATION=your_org_name
LAUNCHABLE_WORKSPACE=your_workspace_name

# Percy.io (Visual Testing)
PERCY_TOKEN=your_percy_token

# BrowserStack (Cross-Browser Testing)
BROWSERSTACK_USERNAME=your_browserstack_username
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key

# =============================================================================
# TEST CONFIGURATION
# =============================================================================

# Test Environment
TEST_ENV=test
TEST_TIMEOUT=30000
HEADLESS_BROWSER=true

# Test Data Generation
FAKER_LOCALE=en_US
TEST_DATA_SEED=12345

# Visual Testing Configuration
VISUAL_REGRESSION_THRESHOLD=0.1
SCREENSHOT_DIR=./screenshots

# Performance Testing
LOAD_TEST_DURATION=5m
LOAD_TEST_USERS=100
LOAD_TEST_RAMP_UP=2m

# =============================================================================
# CI/CD CONFIGURATION
# =============================================================================

# GitHub Actions
CI=true
GITHUB_TOKEN=your_github_token

# Deployment
DEPLOY_ENV=staging
AUTO_DEPLOY=false

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Logging Level
LOG_LEVEL=debug
LOG_FORMAT=json

# Error Tracking (Sentry)
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/Disable AI Features
ENABLE_AI_TEST_GENERATION=true
ENABLE_AI_VISUAL_TESTING=true
ENABLE_AI_PERFORMANCE_TESTING=true
ENABLE_AI_SECURITY_SCANNING=true
ENABLE_SELF_HEALING_TESTS=true

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. Copy this file to .env in your project root
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env file to version control
# 4. Use different values for development, staging, and production
# 5. For local development, many AI tools offer free tiers
# 
# Free Tier Links:
# - Applitools: https://applitools.com/users/register (100 screenshots/month)
# - OpenAI: https://platform.openai.com/signup ($5 free credit)
# - Snyk: https://snyk.io/signup (unlimited for open source)
# - Datadog: https://www.datadoghq.com/free-trial/ (14-day trial)
# - Percy: https://percy.io/signup (5,000 snapshots/month free)
# 
# =============================================================================
