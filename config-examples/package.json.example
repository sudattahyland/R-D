{
  "name": "ai-testing-ecommerce",
  "version": "1.0.0",
  "description": "AI-powered testing project for e-commerce platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:visual": "npm run test:visual:applitools",
    "test:visual:applitools": "cypress run --env eyesEnabled=true",
    "test:visual:percy": "percy exec -- cypress run",
    "test:visual:baseline": "cypress run --env eyesEnabled=true,createBaseline=true",
    "test:api": "jest --testPathPattern=tests/api",
    "test:api:ai": "node scripts/ai-api-test-generator.js && npm run test:api",
    "test:performance": "k6 run performance/ai-load-test.js",
    "test:performance:cloud": "k6 cloud performance/ai-load-test.js",
    "test:security": "npm run security:snyk && npm run security:zap",
    "security:snyk": "snyk test --severity-threshold=high",
    "security:zap": "node scripts/zap-scan.js",
    "test:ai:all": "npm run test:unit && npm run test:integration && npm run test:visual && npm run test:api && npm run test:security",
    "test:smart": "launchable record tests -- npm test",
    "ai:generate-tests": "node scripts/ai-test-generator.js",
    "ai:generate-data": "node scripts/ai-data-generator.js",
    "ai:detect-flaky": "node scripts/ai-flaky-detector.js",
    "report:generate": "node scripts/generate-report.js",
    "report:open": "open test-results/report.html",
    "lint": "eslint src tests --ext .js,.ts,.tsx",
    "lint:fix": "eslint src tests --ext .js,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,ts,tsx}\" \"tests/**/*.{js,ts,tsx}\"",
    "cypress:verify": "cypress verify",
    "postinstall": "npm run cypress:verify"
  },
  "keywords": [
    "ai",
    "testing",
    "automation",
    "e2e",
    "visual-testing",
    "performance",
    "security",
    "ecommerce"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "stripe": "^13.0.0",
    "nodemailer": "^6.9.4",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "redis": "^4.6.8",
    "axios": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.5.9",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.4",
    "@types/supertest": "^2.0.12",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "jest": "^29.6.4",
    "supertest": "^6.3.3",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.1.3",
    "cypress": "^13.2.0",
    "@applitools/eyes-cypress": "^3.37.0",
    "@percy/cypress": "^3.1.2",
    "@faker-js/faker": "^8.0.2",
    "openai": "^4.5.0",
    "eslint": "^8.48.0",
    "prettier": "^3.0.3",
    "@cucumber/cucumber": "^9.5.1",
    "@cucumber/pretty-formatter": "^1.0.0",
    "k6": "^0.0.0",
    "pixelmatch": "^5.3.0",
    "botium-core": "^1.17.0",
    "dd-trace": "^4.15.0",
    "newrelic": "^11.1.0",
    "langchain": "^0.0.140",
    "@tensorflow/tfjs-node": "^4.11.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,ts}",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
